%{
#include <stdio.h>
#include <stdlib.h>
extern FILE *yyin;
%}

/* %s ensures general rules still match while in this state */
%s AFTER_OP

%%

"for"|"in"|"if"|"else"|"elif" { printf("<     KEYWORD               ,   %s     >\n", yytext); BEGIN(INITIAL); }
"True"|"False"                { printf("<     BOOLEAN               ,   %s     >\n", yytext); BEGIN(AFTER_OP); }
"and"|"or"|"not"              { printf("<     LOGICAL_OPERATOR      ,   %s     >\n", yytext); BEGIN(INITIAL); }
"\""[^\"]*"\""|'[^']*'        { printf("<     STRING                ,   %s     >\n", yytext); BEGIN(AFTER_OP); }

<AFTER_OP>"++" { printf("<     POST_INCREMENT        ,   %s     >\n", yytext); BEGIN(AFTER_OP); }
"++"           { printf("<     PRE_INCREMENT         ,   %s     >\n", yytext); BEGIN(AFTER_OP); }
<AFTER_OP>"--" { printf("<     POST_DECREMENT        ,   %s     >\n", yytext); BEGIN(AFTER_OP); }
"--"           { printf("<     PRE_DECREMENT         ,   %s     >\n", yytext); BEGIN(AFTER_OP); }

"=="|"!="|"<="|">="|"<"|">"  { printf("<     RELATIONAL_OPERATOR   ,   %s     >\n", yytext); BEGIN(INITIAL); }
"+="|"-="|"*="|"/="|"%="|"=" { printf("<     ASSIGNMENT_OPERATOR   ,   %s     >\n", yytext); BEGIN(INITIAL); }

<AFTER_OP>"+" { printf("<     BINARY_PLUS           ,   %s     >\n", yytext); BEGIN(INITIAL); }
"+"           { printf("<     UNARY_PLUS            ,   %s     >\n", yytext); BEGIN(INITIAL); }
<AFTER_OP>"-" { printf("<     BINARY_MINUS          ,   %s     >\n", yytext); BEGIN(INITIAL); }
"-"           { printf("<     UNARY_MINUS           ,   %s     >\n", yytext); BEGIN(INITIAL); }
"*"|"/"|"%"   { printf("<     ARITHMETIC_OPERATOR   ,   %s     >\n", yytext); BEGIN(INITIAL); }

[a-zA-Z_][a-zA-Z0-9_]* { printf("<     IDENTIFIER            ,   %s     >\n", yytext); BEGIN(AFTER_OP); }
[0-9]+(\.[0-9]+)?      { printf("<     NUMBER                ,   %s     >\n", yytext); BEGIN(AFTER_OP); }

"("|"["|":"|"," { printf("<     PUNCTUATION           ,   %s     >\n", yytext); BEGIN(INITIAL); }
")"|"]"         { printf("<     PUNCTUATION           ,   %s     >\n", yytext); BEGIN(AFTER_OP); }

[\n]+    { BEGIN(INITIAL); }
[ \t]+   { }
.        { printf("<     UNKNOWN               ,   %s     >\n", yytext); BEGIN(INITIAL); }

%%

int yywrap() { return 1; }

int main() {
    yyin = fopen("input.txt", "r");
    if (!yyin) {
        printf("Error: Could not open input.txt!\n");
        return 1;
    }
    printf("Reading and tokenizing input.txt...\n\n");
    yylex();
    fclose(yyin);
    return 0;
}

